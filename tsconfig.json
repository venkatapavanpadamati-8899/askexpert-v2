{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true
  },
  "include": [
    "supabase/functions/**/*.ts",
    "supabase/functions/deno_types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
